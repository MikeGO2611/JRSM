@startuml
top to bottom direction

package "org.accesodatos.archaios"{

annotation Mike
annotation Javi
annotation Rubén
annotation Sergio

class Archaios{
    - String idUser
    - String idGroup
    - String playName
    - Stats statistics
    + main()
    - preInit()
    - init()
    - end()
    - save()
    - menu()
}

class UserInputParser{
    + getUserInputAsInteger()
    + getUserInputAsChar()
    + getUserInputAsString()
}

class Menu{
    - ArrayList<IOperation> operationCollection

    + askUserForSkill()
    + printArcheologists()
    + hireArcheologist()
    + licenseArcheologist()
    + printSkills()
    + atlas()
}

class Atlas{
    - ArrayList<Region> regionCollection
}

class Stats{
    - int points
    + getPlaceStats()
    + getTreasureStatsByRegion()
    + getTreasureStatsByType()
}

class Repository{
    + getTreasure()
    + getRegion()
    + getSkill()
}

class Treasure{
    - String idCode
    - ETreasureRarity rarity
    - ETreasureType type
    - int parts
    - int points
}

abstract Region{
    + getAllTreasures()
    + getRandomTreasure()
    + getTreasuresOfRarity()
}

class Grecia{
    + static String idCode
    + static List<Treasure> treasureCollection
}

class Archeologist{
    - String name
    - int exp
    - Region specialization
    - List<Skill> skillCollection
    - getLevel()
    - getSkillBonus()
}

abstract Skill{
    + int getBonusRandomTreasures()
    + Map<ETreasureRarity, Integer> getBonusTreasures()
    + float getBonusTreasurePercentage()
    + int getBonusActions()
    + float getBonusActionsPercengate()
    + int getRevelationEmpty()
    + int getRevelationTreasure()
    + List<ETerrainShape> getBonusTerrainShapes()
}

class Excavation{
    - Map<ETerrainShape, Pair<Integer, Integer>> smallShapes
    - Map<ETerrainShape, Pair<Integer, Integer>> mediumShapes
    - Map<ETerrainShape, Pair<Integer, Integer>> bigShapes
    - ArrayList<Treasure> foundTreasures
    - ArrayList<ArrayList<Treasure>> grid

    + generateGrid()
    + excavateIn(Pair<Integer, Integer> coordinates)
    + excavationFinalization()
}

class Zeraf{
    - String idUser
    + sendData(ArrayList<String> treasureCodeCollection)
}

class ZerafFactory{
    + createZeraf(String idUser)
}

class UtilsHelper{
    + ucfirst()
    + ucfirstAll()
    + getPercent()
    + getRandomIdxs()
}

class CodeHelper{
    + getRegion()
    + getType()
    + getTreasureNumber()
    + getTreasurePart()
    + getFullTreasure()
}

interface IOperation {
    + getName()
    + operation()
}

enum ETerrainType{
    SMALL
    MEDIUM
    BIG
}

enum ETerrainShape{
    ROW
    HORIZONTAL
    COLUMN
    VERTICAL
    SQUARE
}

enum ESkillType{
    TREASURE
    EXCAVATION
    TERRAIN
    EXPERT
}

enum ETreasureRarity{
    COMMON
    UNCOMMON
    RARE

    + getCode()
    + getByCode()
}

enum ETreasureType{
    COIN
    TILE
    BEAD
    JEWELRY
    CERAMIC
    EQUIP
    STELE
    FRAGMENT

    + getCode()
    + getByCode()
}

Archaios *-- Stats
Menu <|-- IOperation
Archaios o-- Menu
Menu o-- Atlas
Menu o-- UserInputParser
Atlas o-- CodeHelper

Repository o-- Treasure
Repository o-- Region

Treasure *-- ETreasureType
Treasure *-- ETreasureRarity

Region <|-- Grecia

Archeologist o-- Skill
Skill o-- ESkillType
Archeologist o-- UtilsHelper

Excavation o-- ETerrainShape
Excavation 0-- ETerrainType

ZerafFactory -- Zeraf

Mike -- Archaios
Rubén -- Repository
Javi -- Archeologist
Sergio -- Excavation
Mike -- ZerafFactory
}
@enduml